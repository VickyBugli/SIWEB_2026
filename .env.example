# Copiar este archivo como .env y completar con los datos de tu computadora.
# El archivo .env NO se sube al repositorio.

# Conexión a PostgreSQL: reemplazar TU_CLAVE por la contraseña del usuario postgres
DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/siweb

# Dominio de los emails institucionales aceptados en el registro
DOMINIO_INSTITUCIONAL=est.fi.uncoma.edu.ar

# Opcional: envío real de emails. Si se dejan vacíos, el código de
# verificación se muestra en la terminal del servidor.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=